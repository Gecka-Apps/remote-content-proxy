APP_NAME="Remote Content Proxy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite

CACHE_STORE=file

# =============================================================================
# PROXY CONFIGURATION
# =============================================================================

# API Key Authentication - set to false to allow open access
# PROXY_REQUIRE_API_KEY=true

# Public URL of this proxy instance (used for CSS url() rewriting)
# Defaults to APP_URL. Set this if the proxy is behind a reverse proxy.
# PROXY_BASE_URL=https://proxy.example.com

# Maximum file size for images/CSS/fonts in bytes (default: 10MB)
# PROXY_MAX_FILE_SIZE=10485760

# Maximum file size for videos in bytes (default: 50MB)
# PROXY_MAX_VIDEO_SIZE=52428800

# Request timeout in seconds (default: 10)
# PROXY_TIMEOUT=10

# Connection timeout in seconds, includes SSL handshake (default: 10)
# PROXY_CONNECT_TIMEOUT=10

# Low speed detection - abort if transfer drops below X bytes/sec for Y seconds
# PROXY_LOW_SPEED_LIMIT=1000
# PROXY_LOW_SPEED_TIME=10

# Number of retry attempts with exponential backoff (default: 3)
# PROXY_MAX_RETRIES=3

# User agent for fetching images (default: Thunderbird UA)
# PROXY_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:146.0) Gecko/20100101 Thunderbird/146.0.1"

# =============================================================================
# RATE LIMITING
# =============================================================================

# Enable/disable rate limiting (default: true)
# PROXY_RATE_LIMIT_ENABLED=true

# Maximum requests per time window (default: 100)
# PROXY_RATE_LIMIT_MAX_REQUESTS=100

# Time window in seconds (default: 60)
# PROXY_RATE_LIMIT_WINDOW=60

# =============================================================================
# IMAGE CACHE
# =============================================================================

# Enable/disable image caching (default: true)
# PROXY_CACHE_ENABLED=true

# Cache driver: 'file' or 'redis' (default: file)
# PROXY_CACHE_DRIVER=file

# Cache TTL in seconds (default: 86400 = 24 hours)
# PROXY_CACHE_TTL=86400

# Cache storage path for file driver (default: storage/app/proxy-cache)
# PROXY_CACHE_PATH=

# Maximum cache size in bytes (default: 100MB)
# PROXY_CACHE_MAX_SIZE=104857600

# Start cleanup when cache reaches this percentage of max size (default: 90)
# PROXY_CACHE_CLEANUP_THRESHOLD=90

# Respect client cache control headers (Ctrl+F5 bypass) (default: false)
# Set to true to allow cache bypass via Ctrl+F5
# PROXY_CACHE_RESPECT_CLIENT_HEADERS=false

# =============================================================================
# LOGGING
# =============================================================================

# Log level: 'minimal', 'normal', or 'verbose' (default: normal)
#   - minimal: Only errors (blocked URLs, fetch failures, exceptions)
#   - normal: Errors + warnings (retries, redirects, content issues)
#   - verbose: Everything including cache hits and successful fetches
# PROXY_LOG_LEVEL=normal

# Log full URL on errors for debugging (default: true)
# Set to false in production if URLs contain sensitive data
# PROXY_LOG_FULL_URL=true
